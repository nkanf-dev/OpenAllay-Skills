{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nkanf-dev/OpenAllay-Skills/main/schema/catalog.schema.json",
  "title": "OpenAllay Skill Community Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "generatedAt", "packages"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "kind": {
      "const": "skill"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "description",
        "publisher",
        "version",
        "archive",
        "sha256",
        "compatibility",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "archive": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minecraft", "openallayApi"],
          "properties": {
            "minecraft": {
              "const": "26.2"
            },
            "openallayApi": {
              "const": "0.2"
            }
          }
        },
        "source": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    }
  }
}
